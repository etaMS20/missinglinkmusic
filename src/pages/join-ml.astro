---
import Base from '../layouts/Base.astro';
---
<Base title="Join ML">
    <div class="flex justify-center items-center w-[700px] h-[320px] mx-2.5 sm:m-auto bg-white/90">
        <form action="https://missinglinkmusic.us8.list-manage.com/subscribe/post?u=aa55d4d94976b11e6bec0aa87&amp;id=388c02c9da&amp;f_id=00d173e0f0" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate mx-2.5 sm:m-auto" target="_blank">
            {/* disabled until the newsletter is set up: remove `disabled` and set the button back to "Subscribe" */}
            <fieldset disabled id="mc_embed_signup_scroll">
                <h2 class="text-[1.5em] font-bold">JOIN ML</h2><br>

                <p><b>We are a community of music lovers.</b></p><br>
                <p><b>If you want to join us, subscribe to our ML-Newsletter.</b></p>
                <p>Wenn du dabei sein willst, melde dich zu unserem ML-Newsletter an.</p><br>

                <div class="mc-field-group">
                    <label for="mce-EMAIL">E-Mail-Adresse</label><br>
                    <input type="email" name="EMAIL" class="required email w-full h-[30px] border border-gray-500 bg-white" id="mce-EMAIL" required value="">
                </div>
                <div id="mce-responses" class="clear">
                    <div class="response" id="mce-error-response" style="display: none;"></div>
                    <div class="response" id="mce-success-response" style="display: none;"></div>
                </div>
                <div aria-hidden="true" style="position: absolute; left: -5000px;">
                    <input type="text" name="b_aa55d4d94976b11e6bec0aa87_388c02c9da" tabindex="-1" value="">
                </div>
                <div class="clear">
                    <input type="submit" name="subscribe" id="mc-embedded-subscribe" class="button h-8 mt-[7px] px-5 py-[5px] text-base text-white bg-black cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" value="Coming soon">
                </div>
            </fieldset>
        </form>
        {/* the snippet needs mc-validate's jQuery; after a client-side swap scripts don't run in order, so chain it on load */}
        <script is:inline type="text/javascript" src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js" onload="(function($) {window.fnames = new Array(); window.ftypes = new Array();fnames[0]='EMAIL';ftypes[0]='email';fnames[1]='FNAME';ftypes[1]='text';fnames[2]='LNAME';ftypes[2]='text';fnames[3]='ADDRESS';ftypes[3]='address';fnames[4]='PHONE';ftypes[4]='phone';fnames[5]='BIRTHDAY';ftypes[5]='birthday';fnames[6]='COMPANY';ftypes[6]='text';}(jQuery));window.$mcj = jQuery.noConflict(true);"></script>
    </div>
</Base>
