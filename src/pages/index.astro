---
import Base from '../layouts/Base.astro';
const links = [
    { href: 'https://soundcloud.com/missinglinkdarmstadt', label: 'SoundCloud', icon: 'soundcloud' },
    { href: 'https://instagram.com/missinglink.music', label: 'Missing Link', icon: 'instagram' },
    { href: 'https://instagram.com/studio21da', label: 'Studio21', icon: 'instagram' },
];
---
<Base title="Missing Link">
    <div class="relative z-2 flex flex-col items-center gap-4 m-auto">
        <div class="flex justify-center items-center w-[300px] h-[150px] bg-white/90">
            <img class="w-[250px]" src="/img/ml-logo.png" alt="Missing Link Logo">
        </div>
        <div class="w-[300px] p-4 bg-white/90">
            <p>Missing Link ist ein Darmstädter Musiklabel und Kollektiv von Musikliebhabern.</p>
            <br/>
            <p>Marke des Studio21 e.V. - Verein für Kunst und Kultur</p>
            <ul class="mt-3 font-demi-oblique uppercase">
                {links.map(({ href, label, icon }) => (
                    <li><a href={href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:underline">
                        <img class="size-4" src={`/img/icons/${icon}.svg`} alt="">{label}
                    </a></li>
                ))}
            </ul>
        </div>
    </div>
    <img slot="after" class="fixed top-[90px] right-0 w-[400px] z-1" src="/img/palm.png" alt="Palme">
</Base>
