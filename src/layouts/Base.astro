---
import '../styles/global.css';
import MovingText from '../components/MovingText.astro';
const { title } = Astro.props;
const banner = 'fixed left-0 h-[50px] flex items-center whitespace-nowrap bg-[url(/img/construction-area.png)]';
---
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1">
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body class="w-screen h-svh font-sans text-base sm:text-lg leading-[1.2]">
    <div class={`${banner} top-0`}>
        <MovingText direction="left-to-right" />
    </div>

    <div class="size-full flex justify-center items-center bg-[url(/img/stripes.gif)]">
        <slot />
    </div>

    <div class={`${banner} bottom-0`}>
        <MovingText direction="right-to-left" />
    </div>

    <slot name="after" />
</body>
</html>
