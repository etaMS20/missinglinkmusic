---
import '../styles/global.css';
import MovingText from '../components/MovingText.astro';
import { ClientRouter } from 'astro:transitions';
interface Props { title: string }
const { title } = Astro.props;
const pages = [
  { href: '/', label: 'Home' },
  { href: '/join-ml.html', label: 'Join ML' },
];
// dev serves /join-ml, the build serves /join-ml.html and /index.html
const normalize = (path: string) => path.replace(/(index)?\.html$/, '');
const current = normalize(Astro.url.pathname);
const banner = 'fixed left-0 h-[50px] flex items-center whitespace-nowrap bg-[url(/img/construction-area.png)]';
---
<!DOCTYPE html>
<html lang="de" transition:animate="none">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1">
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <ClientRouter />
</head>
<body class="w-screen h-svh font-sans text-base sm:text-lg leading-[1.2]">
    <div class={`${banner} top-0`} transition:persist="banner-top">
        <MovingText direction="left-to-right" />
    </div>

    <nav class="fixed top-[50px] left-0 z-10 w-full flex gap-6 px-4 py-2 bg-black text-white font-demi-oblique uppercase">
        {pages.map(({ href, label }) => (
            <a
                href={href}
                aria-current={normalize(href) === current ? 'page' : undefined}
                class="hover:underline aria-[current=page]:text-yellow-300"
            >{label}</a>
        ))}
    </nav>

    <div class="size-full flex justify-center items-center bg-[url(/img/stripes.gif)]">
        <slot />
    </div>

    <div class={`${banner} bottom-0`} transition:persist="banner-bottom">
        <MovingText direction="right-to-left" />
    </div>

    <slot name="after" />
</body>
</html>
