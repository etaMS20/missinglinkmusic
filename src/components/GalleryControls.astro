---
// the one place the gallery's controls are listed: start screen and in-game panel
const controls = [
    ['W/A/S/D', 'Bewegen'],
    ['Shift halten', 'Sprinten'],
    ['Leertaste', 'Springen'],
    ['Maus klicken + ziehen', 'Umsehen'],
    ['E', 'Interagieren / Trinken'],
    ['Tab', 'Items'],
    ['ESC', 'Menü'],
];
---
<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
    {controls.map(([keys, action]) => (
        <>
            <span>{keys}</span>
            <span class="text-(--fg)">{action}</span>
        </>
    ))}
</div>
