---
interface Props { direction: 'left-to-right' | 'right-to-left' }
const { direction } = Astro.props;
const text = 'CONSTRUCTION AREA - '.repeat(60);
---
<h1 class="relative font-demi-oblique text-xl font-bold" data-direction={direction}>{text}</h1>

<script>
    // started from JS rather than CSS: a CSS animation restarts when transition:persist moves the banner, this one keeps running
    document.querySelectorAll<HTMLElement>('h1[data-direction]').forEach((h) => {
        const frames = [{ transform: 'translateX(-50%)' }, { transform: 'translateX(0%)' }];
        if (h.dataset.direction === 'right-to-left') frames.reverse();
        h.animate(frames, { duration: 120_000, iterations: Infinity });
    });
</script>
